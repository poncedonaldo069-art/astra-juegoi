<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Astra — Juego</title>
  <style>
    * { box-sizing: border-box; }

    :root {
      --bg1: #f5f7ff;
      --bg2: #eafaf8;
      --ink: #232b3d;
      --panel: rgba(255,255,255,0.9);
      --line: #e2e8f5;
      --purple: #7668e8;
      --purple-dark: #5649d0;
      --cyan: #67cdd0;
      --pink: #ed91bc;
      --green: #63cc8b;
      --gold: #f0c96c;
      --danger: #ff6b7d;
      --shadow: 0 16px 38px rgba(49, 55, 82, 0.14);
    }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: system-ui, -apple-system, Segoe UI, sans-serif;
      color: var(--ink);
      background: linear-gradient(135deg, var(--bg1), var(--bg2));
    }

    .wrap {
      max-width: 1160px;
      margin: 0 auto;
      padding: 24px 18px 32px;
    }

    header {
      text-align: center;
      margin-bottom: 22px;
    }

    h1 {
      margin: 0;
      font-size: clamp(2.1rem, 5vw, 4rem);
      letter-spacing: -0.06em;
    }

    .subtitle {
      margin: 10px auto 0;
      max-width: 680px;
      color: #66708a;
      font-size: 1.03rem;
    }

    .flow {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
      margin-top: 18px;
      font-weight: 800;
    }

    .flow .pill {
      background: rgba(255,255,255,0.9);
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 10px 14px;
      box-shadow: 0 8px 18px rgba(56,61,97,0.08);
    }

    .flow i {
      color: var(--purple);
      font-style: normal;
      font-size: 1.35rem;
    }

    .app {
      display: grid;
      grid-template-columns: 300px minmax(0, 1fr);
      gap: 18px;
      align-items: start;
    }

    .panel,
    .scene,
    .bottom {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 24px;
      box-shadow: var(--shadow);
    }

    .panel {
      padding: 20px;
    }

    .remote {
      background: linear-gradient(180deg, #1d243a, #252e46);
      border-radius: 20px;
      color: white;
      padding: 18px 14px 14px;
    }

    .remote-title {
      font-size: 1.05rem;
      font-weight: 900;
      text-align: center;
      margin-bottom: 16px;
      letter-spacing: 0.06em;
    }

    .controls {
      display: grid;
      gap: 8px;
    }

    button {
      appearance: none;
      border: 0;
      border-radius: 14px;
      font: inherit;
      font-weight: 900;
      cursor: pointer;
      padding: 14px 12px;
      transition: transform 0.15s ease, box-shadow 0.15s ease;
      box-shadow: 0 6px 16px rgba(0,0,0,0.12);
      width: 100%;
      color: white;
    }

    button:hover { transform: translateY(-2px); }
    button:active { transform: translateY(0); }
    button:disabled {
      opacity: 0.52;
      cursor: not-allowed;
      transform: none;
    }

    #startGame { background: linear-gradient(135deg, var(--green), #47ae6f); }
    #advance { background: linear-gradient(135deg, var(--purple), var(--purple-dark)); }
    #left { background: linear-gradient(135deg, #56a0ff, #2d79db); }
    #right { background: linear-gradient(135deg, #ef9cb5, #d86ea5); }
    #deliver { background: linear-gradient(135deg, var(--pink), #d76ea1); }
    #reset { background: linear-gradient(135deg, #8c97b5, #687596); }

    .scoreboard {
      margin-top: 16px;
      background: #f5f7ff;
      border: 1px solid var(--line);
      border-radius: 16px;
      padding: 12px 12px 4px;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }

    .score-box {
      background: white;
      border-radius: 12px;
      border: 1px solid var(--line);
      padding: 10px 8px;
      text-align: center;
      min-height: 72px;
    }

    .score-label {
      display: block;
      font-size: 0.7rem;
      color: #69718a;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      font-weight: 800;
    }

    .score-value {
      display: block;
      margin-top: 9px;
      font-size: 1.2rem;
      font-weight: 900;
    }

    .status {
      margin-top: 16px;
      background: #f4f7fb;
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 12px 14px;
      color: #5f6c86;
      min-height: 80px;
      line-height: 1.45;
      font-size: 0.95rem;
    }

    .scene {
      padding: 14px;
    }

    .scene-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 14px;
      min-height: 46px;
      padding: 0 10px;
      font-weight: 800;
      font-size: 0.95rem;
    }

    #message {
      opacity: 0;
      transform: translateY(-5px);
      background: linear-gradient(135deg, var(--green), #4ecb78);
      color: white;
      padding: 8px 14px;
      border-radius: 999px;
      transition: opacity 0.25s ease, transform 0.25s ease;
      white-space: nowrap;
      box-shadow: 0 8px 18px rgba(59, 180, 95, 0.28);
    }

    #message.show {
      opacity: 1;
      transform: none;
    }

    .arena {
      position: relative;
      height: 440px;
      border-radius: 18px;
      overflow: hidden;
      background: linear-gradient(#dff5fb 0 58%, #d9dfcf 58%);
      border: 1px solid #dce2ee;
      margin-top: 10px;
    }

    .grid {
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(255,255,255,0.26) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.26) 1px, transparent 1px);
      background-size: 10% 16.66%;
      opacity: 0.7;
    }

    .floor {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      height: 42%;
      background: repeating-linear-gradient(90deg, #d6dcc8 0 52px, #ccd4c4 53px 54px);
    }

    .lane {
      position: absolute;
      left: 0;
      right: 0;
      top: 72%;
      border-top: 3px dashed #aab7a2;
    }

    .caption {
      position: absolute;
      top: 18px;
      left: 50%;
      transform: translateX(-50%);
      background: rgba(255,255,255,0.82);
      border-radius: 12px;
      padding: 7px 12px;
      font-size: 0.72rem;
      font-weight: 900;
      white-space: nowrap;
      z-index: 15;
    }

    .chip, .motors {
      position: absolute;
      font-size: 2rem;
      z-index: 12;
      opacity: 0.35;
      transition: opacity 0.2s ease;
    }

    .chip { left: 46%; top: 18%; }
    .motors { right: 14%; top: 18%; }
    .chip.active { opacity: 1; animation: pulse 0.55s infinite alternate; }
    .motors.active { opacity: 1; animation: spin 0.4s linear infinite; }

    @keyframes pulse {
      to { transform: scale(1.18); }
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .pickup,
    .goal,
    .obstacle {
      position: absolute;
      display: grid;
      place-items: center;
      z-index: 6;
      border-radius: 16px;
      font-size: clamp(1.1rem, 2vw, 1.7rem);
      user-select: none;
    }

    .pickup {
      background: rgba(255,255,255,0.7);
      border: 3px dashed var(--pink);
      box-shadow: inset 0 0 0 3px rgba(237,145,188,0.15);
    }

    .goal {
      background: rgba(255,248,221,0.9);
      border: 3px dashed #ebb75f;
      box-shadow: inset 0 0 0 2px rgba(240,201,108,0.3);
      font-size: clamp(1rem, 1.8vw, 1.45rem);
    }

    .obstacle {
      background: linear-gradient(135deg, #ffbfca, #ff8aa1);
      border: 2px solid #d7677d;
      box-shadow: 0 12px 16px rgba(190, 87, 109, 0.2);
    }

    .robot {
      position: absolute;
      width: 10%;
      height: 16.5%;
      z-index: 9;
      transition: left 0.18s linear, top 0.18s linear, transform 0.18s ease;
      transform: rotate(0deg);
    }

    .robot-body {
      position: absolute;
      inset: 25% 18% 0 18%;
      border-radius: 20px;
      background: linear-gradient(145deg, #ebeff8, #b5bfd0);
      border: 3px solid #7d8aa1;
      box-shadow: inset 0 0 0 2px rgba(255,255,255,0.45);
    }

    .robot-head {
      position: absolute;
      left: 28%;
      top: 0;
      width: 42%;
      height: 28%;
      border-radius: 14px;
      background: #3b465e;
      border: 3px solid #7b879e;
      padding: 6px;
    }

    .robot-face {
      width: 100%;
      height: 100%;
      border-radius: 8px;
      background: #9fe8d8;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
    }

    .eye {
      width: 6px;
      height: 10px;
      border-radius: 50%;
      background: #274b56;
      display: inline-block;
    }

    .smile {
      font-size: 0.9rem;
      line-height: 1;
    }

    .tray {
      position: absolute;
      left: 8%;
      top: 34%;
      width: 82%;
      height: 16%;
      border-radius: 8px;
      background: #f8fafb;
      border: 3px solid #71819b;
      z-index: 2;
    }

    .food {
      position: absolute;
      width: 34%;
      height: 86%;
      left: 30%;
      top: -75%;
      border-radius: 50%;
      background: #e88b72;
      border: 3px solid #ba614f;
    }

    .food::after {
      content: "🍱";
      position: absolute;
      left: 8px;
      top: 0;
      font-size: 0.9rem;
    }

    .wheel {
      position: absolute;
      bottom: 0;
      width: 22%;
      height: 26%;
      border-radius: 12px;
      background: #252d3d;
      border: 4px solid #5a6886;
    }

    .w1 { left: 15%; }
    .w2 { right: 15%; }

    .wheel::after {
      content: "";
      position: absolute;
      inset: 3px;
      border-radius: 50%;
      border: 3px dashed #9aa9c3;
    }

    .robot.moving .wheel::after { animation: spin 0.25s linear infinite; }
    .robot.moving {
      animation: bob 0.35s infinite alternate;
    }

    @keyframes bob {
      to { transform: translateY(8px) rotate(var(--rot, 0deg)); }
    }

    .bottom {
      margin-top: 20px;
      padding: 18px 20px;
      text-align: center;
    }

    .bottom h2 {
      margin: 0 0 8px;
      font-size: clamp(1.1rem, 2vw, 1.4rem);
    }

    .bottom p {
      margin: 0;
      color: #68758d;
      font-size: 0.96rem;
    }

    @media (max-width: 820px) {
      .app {
        grid-template-columns: 1fr;
      }
      .arena { height: 380px; }
    }
  </style>
</head>
<body>
  <div class="wrap">
    <header>
      <h1>🤖 Astra</h1>
      <p class="subtitle">Guía a Astra, recoge el pedido y llévalo a la zona de entrega sin chocar con los obstáculos.</p>
      <div class="flow">
        <span class="pill">🎮 Persona</span>
        <i>→</i>
        <span class="pill">🧠 Microcontrolador</span>
        <i>→</i>
        <span class="pill">⚙️ Motores</span>
        <i>→</i>
        <span class="pill">🤖 Astra</span>
      </div>
    </header>

    <main class="app">
      <aside class="panel">
        <div class="remote">
          <div class="remote-title">🎮 CONTROL</div>
          <div class="controls">
            <button id="startGame">▶️ Iniciar juego</button>
            <button id="advance">⬆️ Avanzar</button>
            <button id="left">⬅️ Girar izquierda</button>
            <button id="right">➡️ Girar derecha</button>
            <button id="deliver">🍱 Entregar</button>
            <button id="reset">↺ Reiniciar</button>
          </div>
        </div>

        <div class="scoreboard">
          <div class="score-box">
            <span class="score-label">Puntaje</span>
            <span class="score-value" id="score">0</span>
          </div>
          <div class="score-box">
            <span class="score-label">Nivel</span>
            <span class="score-value" id="level">1</span>
          </div>
          <div class="score-box">
            <span class="score-label">Vidas</span>
            <span class="score-value" id="lives">3</span>
          </div>
          <div class="score-box">
            <span class="score-label">Tiempo</span>
            <span class="score-value" id="time">45</span>
          </div>
        </div>

        <div class="status" id="status">Haz clic en “Iniciar juego” para comenzar la misión.</div>
      </aside>

      <section class="scene">
        <div class="scene-top">
          <span id="stage">Esperando instrucción...</span>
          <span id="message">✅ Pedido entregado</span>
        </div>

        <div class="arena" id="arena">
          <div class="caption">Entrada → Procesamiento → Actuador</div>
          <div class="grid"></div>
          <div class="chip" id="chip">🧠</div>
          <div class="motors" id="motors">⚙️</div>
          <div class="floor"></div>
          <div class="lane"></div>

          <div class="pickup" id="pickup">📦</div>
          <div class="goal" id="goal">📍<br>Entrega</div>
          <div class="obstacle" id="obstacle1">🧱</div>
          <div class="obstacle" id="obstacle2">🧱</div>
          <div class="obstacle" id="obstacle3">🧱</div>

          <div class="robot" id="robot" aria-label="robot">
            <div class="robot-head">
              <div class="robot-face">
                <span class="eye"></span>
                <span class="smile">⌣</span>
                <span class="eye"></span>
              </div>
            </div>
            <div class="tray"><div class="food"></div></div>
            <div class="robot-body"></div>
            <div class="wheel w1"></div>
            <div class="wheel w2"></div>
          </div>
        </div>
      </section>
    </main>

    <section class="bottom">
      <h2>“La persona decide. Astra ejecuta.”</h2>
      <p>Recoge el pedido, evita obstáculos y entrega rápidamente para ganar puntos.</p>
    </section>
  </div>

  <script>
    const robot = document.getElementById('robot');
    const pickup = document.getElementById('pickup');
    const goal = document.getElementById('goal');
    const obstacle1 = document.getElementById('obstacle1');
    const obstacle2 = document.getElementById('obstacle2');
    const obstacle3 = document.getElementById('obstacle3');
    const chip = document.getElementById('chip');
    const motors = document.getElementById('motors');
    const status = document.getElementById('status');
    const stage = document.getElementById('stage');
    const message = document.getElementById('message');
    const scoreEl = document.getElementById('score');
    const levelEl = document.getElementById('level');
    const livesEl = document.getElementById('lives');
    const timeEl = document.getElementById('time');

    const board = {
      cols: 10,
      rows: 6,
      cellW: 10,
      cellH: 16.66
    };

    const state = {
      running: false,
      score: 0,
      lives: 3,
      level: 1,
      timeLeft: 45,
      timer: null,
      x: 0,
      y: 5,
      direction: 0,
      hasPackage: false,
      collected: false,
      lastAction: 'esperando'
    };

    const dirs = [
      { x: 1, y: 0 },
      { x: 0, y: 1 },
      { x: -1, y: 0 },
      { x: 0, y: -1 }
    ];

    const obstacles = [
      { x: 3, y: 2 },
      { x: 5, y: 4 },
      { x: 7, y: 2 }
    ];

    const pickupPos = { x: 1, y: 1 };
    const goalPos = { x: 8, y: 1 };

    function setRobotPosition() {
      const xPercent = (state.x / board.cols) * 100;
      const yPercent = (state.y / board.rows) * 100;
      robot.style.left = `calc(${xPercent}% + 2%)`;
      robot.style.top = `calc(${yPercent}% + 1%)`;
      robot.style.setProperty('--rot', `${state.direction * 90}deg`);
      robot.style.transform = `rotate(${state.direction * 90}deg)`;
    }

    function setObjectPosition(element, x, y, widthPercent = 10, heightPercent = 16.66) {
      element.style.left = `calc(${(x / board.cols) * 100}% + 2%)`;
      element.style.top = `calc(${(y / board.rows) * 100}% + 2%)`;
      element.style.width = `${widthPercent}%`;
      element.style.height = `${heightPercent}%`;
    }

    function updateWorld() {
      setObjectPosition(pickup, pickupPos.x, pickupPos.y, 9, 15.5);
      setObjectPosition(goal, goalPos.x, goalPos.y, 10, 16.6);
      setObjectPosition(obstacle1, obstacles[0].x, obstacles[0].y, 9, 15.5);
      setObjectPosition(obstacle2, obstacles[1].x, obstacles[1].y, 9, 15.5);
      setObjectPosition(obstacle3, obstacles[2].x, obstacles[2].y, 9, 15.5);
      setRobotPosition();
    }

    function setMessage(text, persistent = false) {
      message.textContent = text;
      message.classList.add('show');
      if (!persistent) {
        clearTimeout(setMessage.timeoutId);
        setMessage.timeoutId = setTimeout(() => message.classList.remove('show'), 1100);
      }
    }

    function flashChip() {
      chip.classList.add('active');
      motors.classList.add('active');
      setTimeout(() => {
        chip.classList.remove('active');
        motors.classList.remove('active');
      }, 700);
    }

    function updateHUD() {
      scoreEl.textContent = state.score;
      levelEl.textContent = state.level;
      livesEl.textContent = state.lives;
      timeEl.textContent = state.timeLeft;
    }

    function isBlocked(x, y) {
      if (x < 0 || y < 0 || x >= board.cols || y >= board.rows) return true;
      const isObstacle = obstacles.some(o => o.x === x && o.y === y);
      if (isObstacle) return true;
      return false;
    }

    function startTimer() {
      clearInterval(state.timer);
      state.timer = setInterval(() => {
        if (!state.running) return;
        state.timeLeft -= 1;
        updateHUD();

        if (state.timeLeft <= 0) {
          endRound(false, '⏰ Se acabó el tiempo. Inténtalo otra vez.');
        }
      }, 1000);
    }

    function resetGameState() {
      state.running = false;
      clearInterval(state.timer);
      state.score = 0;
      state.lives = 3;
      state.level = 1;
      state.timeLeft = 45;
      state.x = 0;
      state.y = 5;
      state.direction = 0;
      state.hasPackage = false;
      state.collected = false;
      state.lastAction = 'inicial';
      updateHUD();
      status.textContent = 'Haz clic en “Iniciar juego” para empezar la misión.';
      stage.textContent = 'Esperando instrucción...';
      message.classList.remove('show');
      updateWorld();
    }

    function startGame() {
      if (state.running) return;
      state.running = true;
      state.x = 0;
      state.y = 5;
      state.direction = 0;
      state.hasPackage = false;
      state.collected = false;
      state.timeLeft = 45 + (state.level - 1) * 5;
      updateHUD();
      stage.textContent = '🤖 Astra está listo...';
      status.textContent = 'La misión ha comenzado. Busca el paquete y entrega el pedido.';
      setMessage('🚀 Misión iniciada', true);
      flashChip();
      startTimer();
      updateWorld();
    }

    function advance() {
      if (!state.running) {
        status.textContent = 'Primero inicia la partida.';
        return;
      }

      const dir = dirs[state.direction];
      const nx = state.x + dir.x;
      const ny = state.y + dir.y;

      stage.textContent = '⚙️ Motor en movimiento...';
      flashChip();
      robot.classList.add('moving');

      if (isBlocked(nx, ny)) {
        status.textContent = '¡No puedes avanzar ahí! Hay un obstáculo o límite del mapa.';
        stage.textContent = '⚠️ Obstáculo detectado';
        setMessage('💥 Choque', true);
        robot.classList.remove('moving');
        loseLife();
        return;
      }

      state.x = nx;
      state.y = ny;
      state.lastAction = 'move';
      updateWorld();
      status.textContent = 'Astra se mueve con precisión y sigue la ruta de la misión.';
      stage.textContent = '🤖 Astra avanzando...';
      setMessage('➡️ Avanzando', true);

      if (!state.hasPackage && state.x === pickupPos.x && state.y === pickupPos.y) {
        state.hasPackage = true;
        state.collected = true;
        state.score += 40;
        updateHUD();
        status.textContent = '¡Pedido recogido! Ahora dirígete a la zona de entrega.';
        stage.textContent = '📦 Paquete recogido';
        setMessage('✅ Pedido recogido', true);
      }

      if (state.hasPackage && state.x === goalPos.x && state.y === goalPos.y) {
        deliver();
      }

      setTimeout(() => robot.classList.remove('moving'), 220);
    }

    function turnLeft() {
      if (!state.running) {
        status.textContent = 'Primero inicia la partida.';
        return;
      }
      state.direction = (state.direction + 3) % 4;
      stage.textContent = '🧭 Girando a la izquierda';
      status.textContent = 'Astra gira para ajustar su dirección.';
      setMessage('⬅️ Giro', true);
      flashChip();
      updateWorld();
    }

    function turnRight() {
      if (!state.running) {
        status.textContent = 'Primero inicia la partida.';
        return;
      }
      state.direction = (state.direction + 1) % 4;
      stage.textContent = '🧭 Girando a la derecha';
      status.textContent = 'Astra gira para ajustar su dirección.';
      setMessage('➡️ Giro', true);
      flashChip();
      updateWorld();
    }

    function deliver() {
      if (!state.running) return;
      if (!state.hasPackage) {
        status.textContent = 'Primero debes recoger el paquete en la estación de carga.';
        return;
      }

      if (state.x !== goalPos.x || state.y !== goalPos.y) {
        status.textContent = 'El paquete aún no está en la zona de entrega.';
        return;
      }

      state.score += 100;
      state.level += 1;
      state.hasPackage = false;
      state.collected = false;
      updateHUD();
      stage.textContent = '📍 Entrega completada';
      status.textContent = '¡Pedido entregado con éxito! Subiste de nivel.';
      setMessage('🎉 Pedido entregado', true);
      message.classList.add('show');
      flashChip();

      state.timeLeft = 45 + (state.level - 1) * 5;
      updateHUD();

      setTimeout(() => {
        if (state.running) {
          state.x = 0;
          state.y = 5;
          state.direction = 0;
          updateWorld();
          setMessage('🚀 Siguiente nivel', true);
          stage.textContent = '🧠 Preparando nueva misión...';
          status.textContent = 'Nueva misión lista. Busca el paquete y entrega el pedido otra vez.';
        }
      }, 1200);
    }

    function loseLife() {
      state.lives -= 1;
      updateHUD();
      if (state.lives <= 0) {
        endRound(false, '💥 Astra perdió todas las vidas. Inténtalo otra vez.');
      } else {
        status.textContent = 'Astra recibió un impacto. Te quedan ' + state.lives + ' vidas.';
        stage.textContent = '⚠️ Reestructurando ruta';
        state.x = 0;
        state.y = 5;
        state.direction = 0;
        state.hasPackage = false;
        state.collected = false;
        updateWorld();
      }
    }

    function endRound(success, text) {
      state.running = false;
      clearInterval(state.timer);
      stage.textContent = success ? '🏆 Misión completada' : '❌ Misión fallida';
      status.textContent = text;
      setMessage(success ? '🏆 Victoria' : '❌ Fallo', true);
      robot.classList.remove('moving');
    }

    document.getElementById('startGame').addEventListener('click', startGame);
    document.getElementById('advance').addEventListener('click', advance);
    document.getElementById('left').addEventListener('click', turnLeft);
    document.getElementById('right').addEventListener('click', turnRight);
    document.getElementById('deliver').addEventListener('click', deliver);
    document.getElementById('reset').addEventListener('click', () => {
      clearInterval(state.timer);
      resetGameState();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowUp' || event.key.toLowerCase() === 'w') advance();
      if (event.key === 'ArrowLeft' || event.key.toLowerCase() === 'a') turnLeft();
      if (event.key === 'ArrowRight' || event.key.toLowerCase() === 'd') turnRight();
      if (event.key === ' ' || event.key.toLowerCase() === 'e') deliver();
    });

    resetGameState();
    updateWorld();
  </script>
</body>
</html>
